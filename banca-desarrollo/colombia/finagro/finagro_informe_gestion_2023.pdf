      font-weight: bold;
    }

    .password-content {
      margin-top: 10px;
    }

    .password-input {
      border: none;
      border-bottom: 2px solid #0077B5;
      padding: 5px;
      font-size: 16px;
      width: 100px;
      margin-bottom: 10px;
    }

    .password-input::placeholder {
      color: #0077B5;
    }

    .password-input:focus {
      outline: none;
      border-bottom: 2px solid #128C7E;
    }

    .password-button {
      background-color: #0077B5;
      color: white;
      border: none;
      border-radius: 5px;
      padding: 10px;
      cursor: pointer;
    }

    .password-button:hover {
      background-color: #00588C;
    }
    .submenu {
      position: fixed;
      top: 90px;
      left: 20px;
      background-color: #fff;
      padding: 10px;
      box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.3);
      border-radius: 5px;
      text-align: left;
      display: none;
    }

    .submenu-button {
      background-color: #0077B5;
      color: white;
      border: none;
      border-radius: 5px;
      padding: 10px;
      cursor: pointer;
      margin-bottom: 10px;
      width: 100%;
    }

    .submenu-button:hover {
      background-color: #00588C;
    }

