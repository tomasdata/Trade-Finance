	pointer-events:auto!important;
}
.destacados  .eael-grid-post-holder {
    border: 1px solid #0069E6!important;
}

/*post loops*/
.post-loop-carousel-cont{
	padding:10px;
	overflow:visible;
}

.post-loop-carousel-cont > div{
	box-shadow: 0 0 10px 0 rgba(0,0,0,.15);
	background-color: #fff;
  border: 0 solid #69727d;
  border-radius: 3px;
  display: flex
  flex-direction: column;
  min-height: 100%;
  overflow: hidden;
  position: relative;
  transition: all .25s;
  width: 100%;

}
.elementor-post__excerpt p, .post-loop-carousel-cont .elementor-widget-theme-post-excerpt {
  display: -webkit-box; 
  -webkit-line-clamp: 4; /* Adjust the number of lines here */
  -webkit-box-orient: vertical; 
  overflow: hidden;
  text-overflow: ellipsis; 
}
.post-loop-carousel-cont .elementor-widget-theme-post-featured-image{
	padding-bottom: calc(0.6* 100%);
}
.post-loop-carousel-cont img {
    height:100%;
	  width: 100%;
	  object-fit:cover;
		position:center center;
		left: calc(50% + 1px);
    position: absolute;
    top: calc(50% + 1px);
    transform: scale(1.01) translate(-50%, -50%);
}
.post-loop-carousel-cont:hover > div{
	box-shadow: 0 0 20px 0 rgba(0,0,0,.15);
	border-radius: 3px!important; 
}

.post-loop-carousel-cont h4:hover, .post-loop-carousel-cont:hover a:hover{
	color:#0069E6!important;
}
.bloque_novedades  .blog_post .elementor-widget-theme-post-featured-image a{
	width:100%;
} 

/*nuestra mision*/

.mision_pages .elementor-post:hover h3,
.mision_pages .elementor-post:hover a{
 	color:#0169DE;
}
