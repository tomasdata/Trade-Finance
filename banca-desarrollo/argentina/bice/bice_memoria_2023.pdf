    text-align: center;
    color: #FFFFFF;
    background: #0069E6;
    border-radius: 10px;    
    padding-left:30px;
    padding-right: 30px;
}

.anchor {
    display: block;
    position: absolute;
    top: -100px;
    visibility: hidden!important;
}

/*Estilos end*/

.elementor-element-b68d073{
	padding-left:75px;
	padding-right:80px;
}
/*home */
.home .e-n-carousel.swiper{
	padding-bottom:0px!important;
}
/*autoridades */

.elementor-flip-box__back .elementor-flip-box__layer__inner{
	overflow-y:scroll!important;
}

.icon-box-home:hover{
	cursor:pointer;
}
.bloque_texto a{
	color:#007bff!important;
}
.sub-menu .menu-item{
	min-width:250px;
}
.has-submenu{
	cursor:default;
}
.menu-item-has-children{
	 
}
.destacados_new img{
	height:203px;
	widows:100%;
	object-fit:cover;
	
}

.bdt-element-link.destacados.home{
	height:100%;
}

.destacados.home.e-con-full.e-child{
	height: 100%;
  
}

.destacados.e-loop-item .elementor-widget-theme-post-excerpt div{
	color: #111D29!important;
}
.bloque_destacados .elementor-post__text{
	padding-left:10px;
	padding-right:10px;
}
.bloque_destacados .elementor-post.elementor-grid-item, .bloque_novedades .e-loop-item img{
transition: transform 0.3s ease;
}

.bloque_novedades .elementor-widget-theme-post-featured-image{
	overflow:hidden;
}
.bloque_destacados .elementor-post.elementor-grid-item:hover{
	transform: scale(1.05);
}

.bloque_novedades .e-loop-item:hover h1, .bloque_novedades .e-loop-item:hover a span{
	color:#0033A1!important;
}

.bloque_novedades .e-loop-item:hover img{
	transform: scale(1.05);
}
.page-id-1051 .elementor-element-57844e33{
	display:none;
}

#step_1 .elementskit-btn{
	pointer-events: none;
}
.condiciones_financieras_no_close .ekit_accordion_icon_group, .condiciones_financieras .ekit_accordion_icon_group{
	display:none;
}
/*productos */
.parent-pageid-715 #breadcrumbs > span > span:nth-child(2) > a, .parent-pageid-675 #breadcrumbs > span > span:nth-child(2) > a, .parent-pageid-679 #breadcrumbs > span > span:nth-child(2) > a, .parent-pageid-689 #breadcrumbs > span > span:nth-child(2) > a, .parent-pageid-695 #breadcrumbs > span > span:nth-child(2) > a {
	pointer-events:none;
}
/*condiciones financieras*/
#comments{display:none!important}

.condiciones_financieras_no_close .elementskit-card, .condiciones_financieras_no_close .elementskit-card *, .condiciones_financieras .elementskit-card, .condiciones_financieras .elementskit-card * {
	pointer-events:none;
}
