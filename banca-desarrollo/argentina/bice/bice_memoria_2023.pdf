                           <input type="text" name="nombre_linea" id="nombrelinea" value="">
            <input type="date" name="fecha" value="2025-11-15">            
        </div>
    
        <div class=" ">
            <div class="inputForm">
                <input type="text" name="razon_social" value="" pattern="[A-Za-z]+" placeholder="RAZÓN SOCIAL" class="obligatorio campos_cuit">
                <span class="error"></span>
            </div>
        </div>

        <div class="clearfix" style="margin-top:15px;"></div>
        
        <div class=" ">
            <div class="inputForm">
                <input type="text" name="nombre_completo" value="" pattern="[A-Za-z]+" placeholder="NOMBRE Y APELLIDO DEL CONTACTO" class="obligatorio campos_cuit name">
                <span class="error"></span>
            </div>
        </div>
        <div class="clearfix" style="margin-top:15px;"></div>
       
        <div class=" " style="display:flex;">
   
            <div class="inputForm" style="width:30%;margin-right:10px">
                <input type="text" name="codigo_area" value=""  pattern="[0-9]{1,4}" placeholder="PREFIJO" class="obligatorio campos_cuit codigo_area">                
                <span class="error"></span>
                <span class="aclaracion_pre">Ej: 549</span>
            </div>
            
            <div class="inputForm" style="width:70%;">
                <input type="text" name="tel" value=""  pattern="[0-9]+" placeholder="CELULAR DEL CONTACTO" class="obligatorio campos_cuit tel">
                <span class="error"></span>
                <span class="aclaracion_tel">Debe tener 10 digitos. Ej:11 1234 5678</span>
            </div>
        </div>

        <div class="clearfix" style="margin-top:15px;"></div>

        <div class=" ">
            <div class="inputForm">
                <input type="text" name="email" value=""  placeholder="E-MAIL" class="obligatorio campos_cuit email">
                <span class="error"></span>
            </div>
        </div>
        
        <div class="clearfix" style="margin-top:15px;"></div>
        
        <div class=" ">
            <div class="inputForm">
                <input type="text" name="cuit" value="" placeholder="CUIT" class="campos_cuit cuit">
                <span class="error error_cuit_fogar"></span>
            </div>
        </div>
        <div class="clearfix" style="margin-top:15px;"></div>
        <div class="btn-cuit-cont "  >
            <button type="button" id="btn_enviar_1" class="btn btn-primary btn_cuit"  style="border-radius:10px;">Enviar</button>
            <br>
            <span style="padding-top:15px;"><i class="fa fa-lock" aria-hidden="true"></i> Sus datos se encuentran protegidos</span>
        </div>
        
      

        <div id="loading-icon-2" style="display:none;text-align:center;">
            <span></span>
        </div>
        
        <div class="col-12 rta_cuit_fogar"></div>
        

